<!--
  Windows Sandbox config: a clean, throw-away Windows to try PowerCost as a brand-new user.
  Double-click this file. Nothing is shared with your PC (no mapped folders), and everything
  inside the sandbox is deleted when you close its window.

  The sandbox has no browser, so on start it downloads the newest installer (the same file the
  website's download button gives) from the project's GitHub releases onto its Desktop and opens
  the Desktop:
    PowerCost-setup.exe    the newest release (test the first-run experience)
  To test the in-app update later, install this one while a NEWER M release is published, then
  Settings > Updates > Check for updates.
  A blue "More info" SmartScreen warning is expected (unsigned).
-->
<Configuration>
  <VGpu>Default</VGpu>
  <Networking>Default</Networking>
  <AudioInput>Disable</AudioInput>
  <VideoInput>Disable</VideoInput>
  <PrinterRedirection>Disable</PrinterRedirection>
  <ClipboardRedirection>Enable</ClipboardRedirection>
  <MemoryInMB>4096</MemoryInMB>
  <LogonCommand>
    <Command>powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$ProgressPreference='SilentlyContinue'; $d=[Environment]::GetFolderPath('Desktop'); $r='https://github.com/Nikolaicho-sta/powercost/releases'; try { Invoke-WebRequest ($r+'/latest/download/PowerCost-setup.exe') -OutFile ($d+'\PowerCost-setup.exe') } catch { Write-Host ('Download failed: '+$_.Exception.Message); Read-Host 'Press Enter' }; explorer.exe $d"</Command>
  </LogonCommand>
</Configuration>
